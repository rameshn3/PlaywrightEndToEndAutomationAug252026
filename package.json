{
  "name": "playwright-end-to-end-automation-aug-25-2026",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:ui": "cross-env ENV_ID=dev npx playwright test tests/saucedemo --project=chromium",
    "test:api": "cross-env ENV_ID=qa npx playwright test tests/booking --project=chromium",
    "test:heroku": "cross-env ENV_ID=qa npx playwright test tests/herokuapp --project=chromium",
    "test:all": "npm run test:ui && npm run test:api && npm run test:heroku",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:file:dev": "cross-env ENV_ID=dev npx playwright test --project=chromium",
    "test:file:qa": "cross-env ENV_ID=qa npx playwright test --project=chromium",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:serve": "allure serve ./allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "allure-playwright": "^3.12.0"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2"
  }
}
